# Server
PORT=3000

# Dropbox — use either a long-lived access token OR OAuth2 refresh credentials
DROPBOX_ACCESS_TOKEN=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# DROPBOX_REFRESH_TOKEN=

# Google — use either a service account key file OR OAuth2 credentials
# Option 1: Service Account
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Option 2: OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# CloudConvert (optional — not used if self-hosted ZIP is enabled)
# CLOUDCONVERT_API_KEY=

# Email
EMAIL_FROM=denys@mozzistudio.com
EMAIL_RECIPIENTS=administratif@usi-pro.com,denys@mozzistudio.com

# Logging
LOG_LEVEL=info
